# 复制为 .env 并填入需要用到的密钥；.env 已被 git 忽略，不会提交
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPUAI_API_KEY=

# 接口地址（可选）：走中转站时填写，留空则直连各家官方接口
# Claude 和 Gemini 填站点根地址；OpenAI 兼容接口要以 /v1 结尾
ANTHROPIC_BASE_URL=
GEMINI_BASE_URL=
OPENAI_BASE_URL=

# 各接口使用的型号（可选）：填了就覆盖 config.toml 里的 model
# 中转站用同一个地址提供所有模型，靠型号区分；可用 `lec models --remote <档案名>` 查询可用型号
CLAUDE_MODEL=
GEMINI_MODEL=
GPT_MODEL=
